# Cybersecurity AI — configuração
# Copie para .env e ajuste. NUNCA coloque segredos reais aqui.

# --- IA ---
# AI_PROVIDER: ollama (padrão, local) | openai | lmstudio | openrouter | anthropic | nvidia
# openai/lmstudio/openrouter usam a mesma API OpenAI-compatible
# (/chat/completions), só muda AI_BASE_URL/AI_MODEL/AI_API_KEY. anthropic usa
# a Messages API nativa da Anthropic (ignora AI_BASE_URL).
# AI_MODEL recomendado: DeepHat-V1-7B (fine-tune focado em segurança
# ofensiva/defensiva, mais confiável escolhendo ferramenta e seguindo
# JSON estrito que modelos generalistas como dolphin-llama3):
#   ollama pull hf.co/mradermacher/DeepHat-V1-7B-GGUF:Q5_K_M
AI_PROVIDER=ollama
AI_MODEL=hf.co/mradermacher/DeepHat-V1-7B-GGUF:Q5_K_M
AI_BASE_URL=http://localhost:11434
AI_TEMPERATURE=0.6
AI_CONTEXT_TOKENS=4096
# Modelos maiores (ex: DeepHat-V1-7B) podem levar >60s sintetizando saída
# grande de ferramenta (ex: nmap com fingerprint NSE); 120s dá folga.
AI_TIMEOUT=120
# AI_API_KEY=   # necessário para openai/openrouter/anthropic; LM Studio geralmente não exige
#
# --- Exemplo: Claude (Anthropic) ---
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-4-5-20250929
# AI_API_KEY=sk-ant-...
#
# --- Exemplo: OpenRouter (host único pra várias IAs — Claude/GPT/Llama/...) ---
# Chave em https://openrouter.ai/keys. Troca o modelo sem trocar de provider:
# lista completa em https://openrouter.ai/models.
# AI_PROVIDER=openrouter
# AI_MODEL=anthropic/claude-sonnet-4.5
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...

# --- Research provider (opcional): 2° "cérebro" só pra pesquisa/planejamento ---
# DeepHat (AI_PROVIDER/AI_MODEL acima) continua sendo quem decide e executa as
# ferramentas — é o que ele faz de melhor (tool-selection JSON confiável).
# Se você configurar isso, o Planner (monta o plano de pentest) e o Validator
# (avalia se o resultado bateu o objetivo/o que falta) passam a usar ESTE
# modelo em vez do DeepHat — útil pra um modelo mais forte em raciocínio/
# pesquisa (ex: Claude via openrouter/anthropic) desenhar o plano, e o DeepHat
# só executar as ferramentas do plano. Vazio (padrão) = sem 2° modelo, tudo
# no DeepHat como sempre foi.
# RESEARCH_PROVIDER=openrouter
# RESEARCH_MODEL=anthropic/claude-sonnet-4.5
# RESEARCH_BASE_URL=https://openrouter.ai/api/v1
# RESEARCH_API_KEY=sk-or-...

# --- Banco ---
DATABASE_URL=sqlite:///data/cyber.db

# --- Segurança ---
SAFE_MODE=assisted   # safe | assisted | advanced

# --- OSINT CPF (backend/tools/pentest.py) ---
# Pasta do cpfFinder (https://github.com/... ajuste ao seu setup local).
# CPF_FINDER_DIR=~/cpfFinder

# --- Burp MCP Server (backend/tools/burp.py) ---
# Extensão oficial PortSwigger: Burp > Extensions > BApp Store > "MCP Server"
# (https://portswigger.net/bappstore/9952290f04ed4f628e624d0aa9dccebc).
# Depois de instalar, habilite na aba MCP do Burp (Enabled). Padrão da
# extensão já é 127.0.0.1:9876, só precisa mudar se você alterou a porta lá.
# BURP_MCP_URL=http://127.0.0.1:9876/
# BURP_MCP_TIMEOUT=30

# --- Watcher (monitoramento periódico em segundo plano) ---
WATCHER_ENABLED=true
WATCHER_INTERVAL_SECONDS=300
DISK_ALERT_PERCENT=85
OSINT_RETENTION_DAYS=30

# --- API hardening ---
# API_TOKEN vazio (padrão) = desativado, pensado pro uso local via 127.0.0.1.
# Defina um segredo se o servidor puder ser alcançado além do loopback —
# aí toda rota /api/* (exceto /api/health) exige header X-API-Token.
# API_TOKEN=
RATE_LIMIT_PER_MINUTE=120

# --- Servidor ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
